/* ============ 布局 ============ */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ============ 顶栏 ============ */
.topbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx;
  background: #171327;
  border-bottom: 1rpx solid #2c2745;
}
.loc-chip {
  font-size: 22rpx;
  color: #b9b3d0;
  background: #1c1830;
  border: 1rpx solid #2c2745;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.model-badge {
  font-size: 20rpx;
  color: #a78bfa;
  background: rgba(124, 108, 255, 0.14);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
}
.spacer { flex: 1; }
.icon-btn {
  width: 64rpx;
  height: 64rpx;
  display: grid;
  place-items: center;
  font-size: 32rpx;
  background: #1c1830;
  border: 1rpx solid #2c2745;
  border-radius: 16rpx;
  color: #e8e5f2;
}
.icon-btn.on { color: #c4b5fd; border-color: rgba(124, 108, 255, 0.55); }
.icon-btn.call { color: #c4b5fd; }

/* ============ 消息列表 ============ */
.msgs { flex: 1; padding: 24rpx 24rpx 0; box-sizing: border-box; }
.msgs-bottom { height: 24rpx; }
.msg { display: flex; margin-bottom: 24rpx; align-items: flex-end; }
.msg--user { justify-content: flex-end; }
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #241f3d;
  display: grid;
  place-items: center;
  font-size: 34rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.bubble {
  max-width: 74%;
  padding: 20rpx 26rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}
.msg--user .bubble {
  background: #5b4fc4;
  color: #fff;
  border-bottom-right-radius: 6rpx;
}
.msg--assistant .bubble {
  background: #1c1830;
  border: 1rpx solid #2c2745;
  color: #e8e5f2;
  border-bottom-left-radius: 6rpx;
}
.bubble--error { background: rgba(239, 68, 68, 0.16) !important; border-color: rgba(239, 68, 68, 0.4) !important; }
.user-text { white-space: pre-line; }

/* 打字动画 */
.typing { display: flex; gap: 10rpx; padding: 6rpx 0; }
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8b85a3;
  animation: blink 1.2s infinite;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink {
  0%, 60%, 100% { opacity: 0.3; }
  30% { opacity: 1; }
}

/* Markdown 富文本 */
.md-p { margin: 0; min-height: 8rpx; }
.md-p:first-child { min-height: 0; }
.md-strong { font-weight: 700; }
.md-em { font-style: italic; }
.md-code-inline {
  background: #12101c;
  border: 1rpx solid #2c2745;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 26rpx;
}
.md-link { color: #a78bfa; text-decoration: underline; }
.md-code {
  background: #12101c;
  border: 1rpx solid #2c2745;
  border-radius: 12rpx;
  margin: 10rpx 0;
  overflow: hidden;
}
.md-code-lang {
  font-size: 20rpx;
  color: #8b85a3;
  background: #1c1830;
  padding: 8rpx 16rpx;
  border-bottom: 1rpx solid #2c2745;
}
.md-code-body {
  padding: 16rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  white-space: pre-wrap;
  color: #d8e0ff;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  color: #8b85a3;
}
.empty-emoji { font-size: 72rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 26rpx; }

/* ============ 输入区 ============ */
.inputbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #171327;
  border-top: 1rpx solid #2c2745;
}
.mic {
  width: 72rpx;
  height: 72rpx;
  display: grid;
  place-items: center;
  font-size: 34rpx;
  background: #1c1830;
  border: 1rpx solid #2c2745;
  border-radius: 50%;
}
.mic.rec {
  background: rgba(239, 68, 68, 0.2);
  border-color: rgba(239, 68, 68, 0.5);
  animation: pulse 1.4s infinite;
}
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}
.ipt {
  flex: 1;
  background: #1c1830;
  border: 1rpx solid #2c2745;
  border-radius: 999rpx;
  padding: 18rpx 30rpx;
  font-size: 30rpx;
}
.ph { color: #5d5776; }
.send {
  min-width: 110rpx;
  text-align: center;
  background: #7c6cff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 18rpx 26rpx;
}
.send.is-stop { background: #ef4444; }

/* ============ 浮层 ============ */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(10, 8, 18, 0.94);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.overlay.hidden { display: none; }

/* 登录 */
.login-card {
  width: 80%;
  background: #1c1830;
  border: 1rpx solid #2c2745;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
}
.login-title { font-size: 36rpx; font-weight: 700; text-align: center; }
.login-sub { font-size: 24rpx; color: #8b85a3; text-align: center; margin: 14rpx 0 30rpx; }
.login-ipt {
  background: #12101c;
  border: 1rpx solid #2c2745;
  border-radius: 14rpx;
  padding: 20rpx 26rpx;
  font-size: 30rpx;
}
.login-error { color: #f87171; font-size: 24rpx; margin-top: 14rpx; text-align: center; }
.login-btn {
  margin-top: 36rpx;
  background: #7c6cff;
  color: #fff;
  border-radius: 14rpx;
  font-size: 30rpx;
}

/* ============ 通话界面 ============ */
.call-page {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.call-head { display: flex; align-items: center; gap: 20rpx; }
.call-timer { font-size: 28rpx; color: #8b85a3; font-variant-numeric: tabular-nums; }
.call-model { font-size: 22rpx; color: #a78bfa; }

.call-avatar-wrap { position: relative; width: 240rpx; height: 240rpx; margin-top: 50rpx; }
.call-avatar-wrap::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 4rpx solid rgba(124, 108, 255, 0.5);
  animation: call-ring 2.2s infinite;
}
.call-avatar-wrap.is-speaking::before { animation-duration: 1s; }
.call-avatar-wrap.is-muted::before { animation: none; border-color: #2c2745; }
@keyframes call-ring {
  0% { transform: scale(1); opacity: 0.9; }
  100% { transform: scale(1.35); opacity: 0; }
}
.call-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #241f3d;
  display: grid;
  place-items: center;
  font-size: 100rpx;
}
.call-name { font-size: 40rpx; font-weight: 700; margin-top: 30rpx; }
.call-status { font-size: 26rpx; color: #8b85a3; margin-top: 10rpx; min-height: 36rpx; }

.call-transcript {
  flex: 1;
  width: 100%;
  margin-top: 30rpx;
  overflow: hidden;
}
.call-msg {
  max-width: 80%;
  padding: 16rpx 24rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  line-height: 1.5;
}
.call-msg--user {
  background: #5b4fc4;
  color: #fff;
  margin-left: auto;
  border-bottom-right-radius: 6rpx;
}
.call-msg--assistant {
  background: #1c1830;
  border: 1rpx solid #2c2745;
  border-bottom-left-radius: 6rpx;
}

.call-actions {
  display: flex;
  gap: 60rpx;
  margin-top: 30rpx;
}
.call-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #1c1830;
  border: 1rpx solid #2c2745;
  display: grid;
  place-items: center;
  font-size: 22rpx;
  text-align: center;
  color: #e8e5f2;
  line-height: 1.4;
}
.call-btn.is-muted { color: #fbbf24; border-color: rgba(251, 191, 36, 0.5); }
.call-btn.hangup { background: rgba(239, 68, 68, 0.16); border-color: rgba(239, 68, 68, 0.5); }
