<view class="page">
  <!-- 顶栏 -->
  <view class="topbar">
    <view class="loc-chip" bindtap="onLocationTap">{{locationText}}</view>
    <view class="model-badge" wx:if="{{model}}">{{model}}</view>
    <view class="spacer"></view>
    <view class="icon-btn {{voiceOn ? 'on' : ''}}" bindtap="toggleVoice" aria-label="语音播报开关">{{voiceOn ? '🔊' : '🔇'}}</view>
    <view class="icon-btn" bindtap="onMenu">⋯</view>
    <view class="icon-btn call" bindtap="startCall">📞</view>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="msgs" scroll-y scroll-into-view="m{{lastKey}}" scroll-with-animation>
    <view wx:if="{{empty}}" class="empty">
      <text class="empty-emoji">💗</text>
      <text class="empty-text">{{name}} 正在等你开口…</text>
    </view>
    <view
      wx:for="{{messages}}"
      wx:key="key"
      id="m{{item.key}}"
      class="msg msg--{{item.role}}"
    >
      <view class="avatar" wx:if="{{item.role === 'assistant'}}">{{meta.emoji}}</view>
      <view class="bubble {{item.error ? 'bubble--error' : ''}}">
        <view wx:if="{{item.pending}}" class="typing">
          <view class="dot"></view><view class="dot"></view><view class="dot"></view>
        </view>
        <rich-text wx:elif="{{item.role === 'assistant'}}" nodes="{{item.nodes}}"></rich-text>
        <text wx:else class="user-text">{{item.text}}</text>
      </view>
    </view>
    <view class="msgs-bottom"></view>
  </scroll-view>

  <!-- 输入区 -->
  <view class="inputbar">
    <view class="mic {{recording ? 'rec' : ''}}" bindtap="onMicTap">{{recording ? '⏹' : '🎤'}}</view>
    <input
      class="ipt"
      value="{{input}}"
      placeholder="{{recording ? '正在聆听，点⏹结束…' : '说点什么…'}}"
      placeholder-class="ph"
      confirm-type="send"
      bindinput="onInput"
      bindconfirm="onSend"
      disabled="{{recording}}"
    />
    <view class="send {{isStreaming ? 'is-stop' : ''}}" bindtap="onSend">{{isStreaming ? '⏹' : '发送'}}</view>
  </view>

  <!-- 登录浮层 -->
  <view class="overlay {{needLogin ? '' : 'hidden'}}">
    <view class="login-card">
      <view class="login-title">🔒 访问密码</view>
      <view class="login-sub">本站开启了访问保护，请输入密码</view>
      <input
        class="login-ipt"
        password
        value="{{loginPwd}}"
        placeholder="访问密码"
        placeholder-class="ph"
        bindinput="onLoginPwd"
        bindconfirm="doLogin"
      />
      <view class="login-error" wx:if="{{loginError}}">{{loginError}}</view>
      <button class="login-btn" bindtap="doLogin">进入</button>
    </view>
  </view>

  <!-- 通话浮层 -->
  <view class="overlay {{call ? '' : 'hidden'}}">
    <view class="call-page">
      <view class="call-head">
        <view class="call-timer">{{callTimer}}</view>
        <view class="call-model" wx:if="{{model}}">{{model}}</view>
      </view>
      <view class="call-avatar-wrap {{callState === 'speaking' ? 'is-speaking' : callState === 'listening' ? 'is-listening' : callState === 'muted' ? 'is-muted' : ''}}">
        <view class="call-avatar">{{meta.emoji}}</view>
      </view>
      <view class="call-name">{{name}}</view>
      <view class="call-status">{{callStatus}}</view>

      <scroll-view class="call-transcript" scroll-y scroll-into-view="t{{lastTKey}}">
        <view wx:for="{{transcript}}" wx:key="key" id="t{{item.key}}" class="call-msg call-msg--{{item.role}}">
          <text>{{item.text}}</text>
        </view>
      </scroll-view>

      <view class="call-actions">
        <view class="call-btn {{muted ? 'is-muted' : ''}}" bindtap="toggleMute">{{muted ? '🔇\n已静音' : '🎙\n静音'}}</view>
        <view class="call-btn hangup" bindtap="endCall">📵\n挂断</view>
      </view>
    </view>
  </view>
</view>
