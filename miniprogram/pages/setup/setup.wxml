<view class="setup">
  <view class="logo">
    <text class="logo-emoji">💞</text>
    <view class="logo-title">AI 女友</view>
    <view class="logo-sub">选一个性格，给她起个名字</view>
  </view>

  <view class="cards">
    <view
      wx:for="{{personalities}}"
      wx:key="key"
      class="card {{personality === item.key ? 'selected' : ''}}"
      data-key="{{item.key}}"
      bindtap="pickPersonality"
    >
      <text class="card-emoji">{{item.emoji}}</text>
      <view class="card-label">{{item.label}}</view>
      <view class="card-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="name-row">
    <input
      class="name-input"
      placeholder="她叫什么名字"
      placeholder-class="ph"
      value="{{name}}"
      maxlength="12"
      bindinput="onName"
      confirm-type="done"
      bindconfirm="start"
    />
  </view>

  <button class="start-btn" disabled="{{!canStart}}" bindtap="start">
    开始我们的对话 {{personalityMeta.emoji}}
  </button>
</view>
