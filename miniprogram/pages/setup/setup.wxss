.setup {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 40rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.logo {
  text-align: center;
  margin-bottom: 50rpx;
}
.logo-emoji { font-size: 80rpx; }
.logo-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-top: 12rpx;
}
.logo-sub {
  font-size: 26rpx;
  color: #8b85a3;
  margin-top: 8rpx;
}

.cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 100%;
}
.card {
  width: 48%;
  box-sizing: border-box;
  background: #1c1830;
  border: 2rpx solid #2c2745;
  border-radius: 20rpx;
  padding: 26rpx 22rpx;
  margin-bottom: 20rpx;
  transition: border-color 0.2s;
}
.card.selected {
  border-color: #7c6cff;
  background: rgba(124, 108, 255, 0.14);
}
.card-emoji { font-size: 44rpx; }
.card-label {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 8rpx;
}
.card-desc {
  font-size: 22rpx;
  color: #8b85a3;
  margin-top: 6rpx;
}

.name-row {
  width: 100%;
  margin-top: 24rpx;
}
.name-input {
  background: #1c1830;
  border: 2rpx solid #2c2745;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  font-size: 30rpx;
}
.ph { color: #5d5776; }

.start-btn {
  width: 100%;
  margin-top: 40rpx;
  background: #7c6cff;
  color: #fff;
  font-size: 32rpx;
  border-radius: 20rpx;
}
.start-btn[disabled] {
  background: #2c2745;
  color: #5d5776;
}
